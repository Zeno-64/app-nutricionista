# Copie para .env e preencha. O .env não vai para o repositório.

# Projeto Supabase (região de São Paulo)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Só em ambiente de servidor, nunca no app nem no painel.
SUPABASE_SERVICE_ROLE_KEY=

# Painel web (Vite expõe ao navegador tudo que começa com VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App (Expo expõe ao aplicativo tudo que começa com EXPO_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
